# Aplicação
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CONTACT_EMAIL=seu-email@exemplo.com

# Origem de postagem
# Substitua pelo CEP real antes de testar a SuperFrete.
ORIGIN_POSTAL_CODE=00000000

# Medidas provisórias POR UNIDADE de caneca.
# Medir a embalagem real antes do lançamento.
PACKAGE_WEIGHT_KG=0.6
PACKAGE_HEIGHT_CM=15
PACKAGE_WIDTH_CM=15
PACKAGE_LENGTH_CM=15
PRODUCTION_DAYS_MIN=2
PRODUCTION_DAYS_MAX=4

# SuperFrete
SUPERFRETE_ENV=sandbox
SUPERFRETE_TOKEN=
SUPERFRETE_USER_AGENT=LojinhaBartolomeu/1.0 (seu-email@exemplo.com)

# InfinitePay
# InfiniteTag sem o símbolo $.
INFINITEPAY_HANDLE=
